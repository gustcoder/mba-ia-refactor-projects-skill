# Copie para .env e preencha os valores reais. Nunca commite o .env preenchido.

# Obrigatório em produção (DEBUG=false); em dev, se omitido, um valor default inseguro é usado.
SECRET_KEY=

# Modo debug do Flask (nunca "true" em produção)
DEBUG=true

# String de conexão do banco (default: sqlite:///tasks.db)
DATABASE_URL=

# Tempo de expiração do JWT emitido no login, em segundos (default: 86400 = 24h)
JWT_EXPIRATION_SECONDS=86400

# Credenciais SMTP usadas pelo NotificationService
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
